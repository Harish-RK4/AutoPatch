# AutoPatch Voice Brain Environment Variables
# Copy this to .env in your project root

TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_BASE_URL=https://your-public-tunnel-or-api.com

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Lifelike Neural Voices
AUTOPATCH_VOICE_IN=Polly.Kajal-Neural
AUTOPATCH_VOICE_US=Polly.Joanna-Neural
