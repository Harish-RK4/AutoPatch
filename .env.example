# ==============================================================================
# AutoPatch Environment Variables Template
# Copy this file to .env and provide your local credentials.
# NEVER commit real API keys, secrets, or certificates to source control.
# ==============================================================================

# App Environment: development | production | test
NODE_ENV=development
APP_ENV=development

# ------------------------------------------------------------------------------
# Authentication & Demo Mode Configuration
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_AUTH_MODE: 'demo' (mock credentials) | 'supabase' (live Supabase auth)
NEXT_PUBLIC_AUTH_MODE=demo

# DEMO_MODE: Enables isolated /demo fixtures & demo banner. MUST be false in production!
DEMO_MODE=true

# ------------------------------------------------------------------------------
# LLM Router Configuration
# ------------------------------------------------------------------------------
# LLM_MODE: 'mock' (deterministic fixtures, 0 keys needed) | 'free' (real free providers) | 'private' (local Ollama only)
LLM_MODE=mock

# Free Tier Providers (Required only when LLM_MODE=free)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Provider Model IDs (Configurable per dashboard recommendations)
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.1-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
MISTRAL_CODE_MODEL=codestral-latest
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional Paid Provider Keys (Leave blank for free-tier testing)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Infrastructure & Sandbox Isolation
# ------------------------------------------------------------------------------
# SANDBOX_MODE: 'docker' (production default: network none, capped) | 'local_dev' (dev-only fallback)
SANDBOX_MODE=docker
REDIS_URL=redis://localhost:6379/0
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Database, Storage & Realtime (Supabase)
# Required after completing Phase P5 / enabling Supabase mode
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ------------------------------------------------------------------------------
# Push Notifications (Firebase FCM)
# Required after completing Phase P6 / enabling Firebase notifications
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# Optional Ecosystem Integrations
# ------------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
SENTRY_AUTH_TOKEN=
NVD_API_KEY=
SEMGREP_APP_TOKEN=
